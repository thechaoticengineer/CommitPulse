# Local credentials and configuration
.env
.env.*
!.env.example

# Editor and operating system files
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Local logs
*.log

# Isolated Quickshell smoke output, when TMPDIR is pointed at the repository.
commitpulse-smoke.*/

# Forge runtime and local contribution cache
.forge/
.commitpulse/
commitpulse-data
success-v1.json
retry-v1.json
cache.lock
.commitpulse-*.tmp
bin/
dist/
coverage.out

# Keep the read-only Codex review-sandbox mount point while ignoring all
# provider-generated agent state.
.agents/*
!.agents/.gitkeep
